<Window
  x:Class="ResoDrive.App.MessageDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  Title="{x:Static local:ProductInfo.Name}"
  Width="410"
  MaxHeight="520"
  SizeToContent="Height"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Background="{StaticResource WindowBrush}"
  Foreground="{StaticResource TextBrush}"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="24,20,24,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        x:Name="SeverityGlyph"
        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
        FontSize="17"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        AutomationProperties.Name="Message severity"
      />
      <TextBlock
        x:Name="HeadingText"
        Grid.Column="1"
        Margin="8,0,0,0"
        FontSize="20"
        FontWeight="SemiBold"
        TextWrapping="Wrap"
        AutomationProperties.LiveSetting="Assertive"
      />
      <ScrollViewer Grid.Row="1" Grid.Column="1" MaxHeight="280" Margin="8,9,0,0" VerticalScrollBarVisibility="Auto">
        <TextBlock
          x:Name="MessageText"
          Foreground="{StaticResource MutedBrush}"
          LineHeight="20"
          TextWrapping="Wrap"
          AutomationProperties.Name="Message"
        />
      </ScrollViewer>
    </Grid>
    <Border
      Grid.Row="1"
      Background="{StaticResource NavBrush}"
      BorderBrush="{StaticResource BorderBrush}"
      BorderThickness="0,1,0,0"
      Padding="24,12"
    >
      <StackPanel
        x:Name="ButtonsPanel"
        Orientation="Horizontal"
        HorizontalAlignment="Right"
      />
    </Border>
  </Grid>
</Window>
