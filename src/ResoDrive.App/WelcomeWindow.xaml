<Window
  x:Class="ResoDrive.App.WelcomeWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  Title="{x:Static local:ProductInfo.WelcomeTitle}"
  Width="520"
  Height="390"
  MinWidth="520"
  MinHeight="390"
  MaxWidth="520"
  MaxHeight="390"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Background="{StaticResource WindowBrush}"
  Foreground="{StaticResource TextBrush}"
>
  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Image Width="34" Height="34" Source="Assets/resodrive-mark.png" Stretch="Uniform" />
      <TextBlock Text="{x:Static local:ProductInfo.Name}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,25,0,18">
      <Grid x:Name="DrivePage">
        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="68" Height="68" CornerRadius="12" Background="#263F5A" HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="#69B7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="8,2,0,0">
          <TextBlock Text="Your storage, in File Explorer" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="21" TextWrapping="Wrap" Text="Connect WebDAV or SFTP storage and open it as a familiar Windows drive. Mount only the drives you need, when you need them." />
        </StackPanel>
      </Grid>

      <Grid x:Name="SyncPage" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="68" Height="68" CornerRadius="12" Background="#263F5A" HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="#69B7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="8,2,0,0">
          <TextBlock Text="Mount and sync on your terms" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="21" TextWrapping="Wrap" Text="{x:Static local:ProductInfo.WelcomeTrayText}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="RclonePage" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="68" Height="68" CornerRadius="12" Background="#263F5A" HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="#69B7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="8,2,0,0">
          <TextBlock Text="Powered by rclone" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="21" TextWrapping="Wrap" Text="{x:Static local:ProductInfo.WelcomeRcloneText}" />
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="2">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="{StaticResource AccentBrush}" />
        <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="{StaticResource BorderBrush}" Margin="7,0,0,0" />
        <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="{StaticResource BorderBrush}" Margin="7,0,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SkipButton" Style="{StaticResource ButtonStyle}" Content="Skip" Click="Skip_Click" />
        <Button x:Name="BackButton" Style="{StaticResource ButtonStyle}" Content="Back" Margin="8,0,0,0" Visibility="Collapsed" Click="Back_Click" />
        <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Next" Margin="8,0,0,0" IsDefault="True" Click="Next_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
