<Window
  x:Class="ResoDrive.App.AboutWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  Title="{x:Static local:ProductInfo.AboutTitle}"
  Width="440"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Background="{StaticResource WindowBrush}"
  Foreground="{StaticResource TextBrush}"
>
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid MinHeight="60">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image
        Width="52"
        Height="52"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Source="Assets/resodrive-mark.png"
        Stretch="Uniform"
        RenderOptions.BitmapScalingMode="HighQuality"
      />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{x:Static local:ProductInfo.Name}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock
          x:Name="VersionText"
          Foreground="{StaticResource MutedBrush}"
          Margin="0,3,0,0"
        />
        <TextBlock Text="{x:Static local:ProductInfo.DeveloperName}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
      </StackPanel>
    </Grid>

    <Button
      Grid.Row="1"
      Style="{StaticResource ButtonStyle}"
      Height="Auto"
      MinHeight="58"
      Padding="14,9"
      Margin="0,20,0,0"
      HorizontalContentAlignment="Stretch"
      Click="OpenRepository_Click"
      AutomationProperties.Name="Open ResoDrive repository on GitHub"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="ResoDrive on GitHub" FontWeight="SemiBold" />
          <TextBlock Text="Source, releases, and documentation" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
        </StackPanel>
        <TextBlock
          Grid.Column="1"
          Text="&#xE8A7;"
          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
          Foreground="{StaticResource MutedBrush}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
        />
      </Grid>
    </Button>

    <Button
      Grid.Row="2"
      Style="{StaticResource ButtonStyle}"
      Height="Auto"
      MinHeight="58"
      Padding="14,9"
      Margin="0,8,0,0"
      HorizontalContentAlignment="Stretch"
      Click="OpenIssues_Click"
      AutomationProperties.Name="Report a ResoDrive issue on GitHub"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Report an issue" FontWeight="SemiBold" />
          <TextBlock Text="Open the GitHub issue tracker" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
        </StackPanel>
        <TextBlock
          Grid.Column="1"
          Text="&#xE8A7;"
          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
          Foreground="{StaticResource MutedBrush}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
        />
      </Grid>
    </Button>

    <Button
      Grid.Row="3"
      Style="{StaticResource AccentButton}"
      Content="Close"
      HorizontalAlignment="Right"
      Margin="0,20,0,0"
      IsDefault="True"
      IsCancel="True"
    />
  </Grid>
</Window>
