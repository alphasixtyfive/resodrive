<Window
  x:Class="ResoDrive.App.MountEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  Title="Drive settings"
  Width="520"
  Height="540"
  MinWidth="480"
  MinHeight="500"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Background="{StaticResource WindowBrush}"
  Foreground="{StaticResource TextBrush}"
>
  <Grid Margin="22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,12">
      <TextBlock x:Name="Heading" Text="Add drive" FontSize="20" FontWeight="SemiBold" />
      <TextBlock
        x:Name="ConnectionText"
        Text="Mount another folder from your configured storage."
        Foreground="{StaticResource MutedBrush}"
        Margin="0,3,0,0"
      />
    </StackPanel>

    <ScrollViewer
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
    >
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Name" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="Drive name" />

        <TextBlock Grid.Row="1" Text="Folder" VerticalAlignment="Center" />
        <TextBox
          x:Name="RemotePathBox"
          Grid.Row="1"
          Grid.Column="1"
          Style="{StaticResource EditorTextBox}"
          ToolTip="Optional folder inside the storage connection. Leave empty for its root."
          AutomationProperties.Name="Remote folder"
        />

        <TextBlock Grid.Row="2" Text="Drive letter" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox
            x:Name="DriveBox"
            Style="{StaticResource EditorComboBox}"
            Width="88"
            AutomationProperties.Name="Drive letter"
          />
          <TextBlock
            x:Name="DriveStatusText"
            Text="Checking…"
            Foreground="{StaticResource MutedBrush}"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
          />
          <CheckBox
            x:Name="NetworkModeBox"
            Content="Network drive"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            ToolTip="Present this mount to Windows as a network drive instead of a fixed drive."
            AutomationProperties.Name="Present as a network drive"
          />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Availability" VerticalAlignment="Center" />
        <CheckBox
          x:Name="EnabledBox"
          Grid.Row="3"
          Grid.Column="1"
          Content="Enabled"
          AutomationProperties.Name="Drive enabled"
          VerticalAlignment="Center"
        />

        <TextBlock Grid.Row="4" Text="Startup" VerticalAlignment="Center" />
        <CheckBox
          x:Name="AutoMountBox"
          Grid.Row="4"
          Grid.Column="1"
          Content="{x:Static local:ProductInfo.MountOnStartText}"
          AutomationProperties.Name="{x:Static local:ProductInfo.MountOnStartText}"
          VerticalAlignment="Center"
        />

        <TextBlock Grid.Row="5" Text="Recovery" VerticalAlignment="Center" />
        <StackPanel
          Grid.Row="5"
          Grid.Column="1"
          Orientation="Horizontal"
          VerticalAlignment="Center"
        >
          <CheckBox
            x:Name="RestartBox"
            Content="Reconnect"
            Margin="0,0,12,0"
            Checked="Restart_Changed"
            Unchecked="Restart_Changed"
            AutomationProperties.Name="Reconnect automatically"
          />
          <TextBlock Text="up to" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
          <TextBox
            x:Name="AttemptsBox"
            Style="{StaticResource EditorTextBox}"
            Width="48"
            Margin="8,0"
            ToolTip="Maximum reconnect attempts"
            AutomationProperties.Name="Maximum reconnect attempts"
          />
          <TextBlock Text="times" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Expander
          Grid.Row="6"
          Grid.ColumnSpan="2"
          Header="Advanced"
          Margin="0,7,0,0"
        >
          <Grid Margin="0,6,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="40" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="116" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Caching" VerticalAlignment="Center" />
            <ComboBox
              x:Name="CacheBox"
              Grid.Column="1"
              Style="{StaticResource EditorComboBox}"
              AutomationProperties.Name="Cache behavior"
            />

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
              <TextBlock Text="Additional rclone options" FontWeight="SemiBold" />
              <TextBlock
                Text="One option per line. Keep values together, for example --poll-interval=30s."
                Foreground="{StaticResource MutedBrush}"
                TextWrapping="Wrap"
                Margin="0,3,0,0"
              />
              <TextBox
                x:Name="ArgumentsBox"
                Style="{StaticResource ArgumentTextBox}"
                Margin="0,7,0,0"
                AcceptsReturn="True"
                AutomationProperties.Name="Additional rclone options"
              />
            </StackPanel>
          </Grid>
        </Expander>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Button
        x:Name="DeleteButton"
        Style="{StaticResource ButtonStyle}"
        Content="Delete"
        HorizontalAlignment="Left"
        Click="Delete_Click"
      />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button
          Style="{StaticResource ButtonStyle}"
          Content="Cancel"
          Margin="0,0,8,0"
          IsCancel="True"
        />
        <Button
          x:Name="SaveButton"
          Style="{StaticResource AccentButton}"
          Content="Save"
          IsDefault="True"
          Click="Save_Click"
        />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
