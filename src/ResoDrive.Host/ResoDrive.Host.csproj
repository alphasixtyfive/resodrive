<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>ResoDrive.Host</RootNamespace>
    <OutputType>Library</OutputType>
    <SelfContained>false</SelfContained>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>ResoDrive.Host</AssemblyName>
    <Product>$(ProductDisplayName) background host</Product>
    <Description>Per-user rclone mount and transfer supervisor</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResoDrive.Core\ResoDrive.Core.csproj" />
    <ProjectReference Include="..\ResoDrive.Windows\ResoDrive.Windows.csproj" />
  </ItemGroup>
</Project>
